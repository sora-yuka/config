// Input device configuration.
// Full list of options on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Input

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:shift_caps_toggle"
        }
        
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse

    trackpoint
}
