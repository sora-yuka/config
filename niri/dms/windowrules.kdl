// Control how much the workspaces zoom out in the overview.
// zoom ranges from 0 to 0.75 where lower values make everything smaller.
overview {
    zoom 0.75
}

// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Window-Rules

// Example: block out two password managers from screen capture.
// (This is example rule is commented out with a "/-" in front).
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

// Here are all matchers
/-window-rule {
    match title="Firefox"
    // You can get app-id by typing niri msg pick-window and clicking on app.
    match app-id="ghostty" // or com.mitchellh.ghostty
    match is-active=true
    match is-focused=false
    match is-active-in-column=true
    match is-floating=true
    match is-window-cast-target=true
    match is-urgent=true
    match at-startup=true

    // Properties that apply once upon window opening.
    default-column-width { proportion 0.75; }
    default-fixed-height { fixed 500; }
    open-on-output "Graphic Card output"
    open-on-workspace "chat" // If you set name for workspace
    open-maximized true
    open-maximized-to-edges true
    open-fullscreen true
    open-floating true
    open-focused false

    // Properties that apply continuously.
    draw-border-with-background false
    opacity 0.5
    block-out-from "screencast"
    // block-out-from "screen-capture"
    variable-refresh-rate true
    default-column-display "tabbed"
    default-floating-position x=100 y=200 relative-to="bottom-left"
    scroll-factor 0.75
    pinch-sensitivity 1.25
    on-xdg-active "focus"

    focus-ring {
        // off
        on
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
        urgent-color "#9b0000"
        // active-color from="#80c8ff" to="bbddff" angle=45 -> same for others
    }

    border {
        // same as focus-ring
    }

    shadow {
        // on
        softness 40
        spread 5
        offset x=0 y=5
        draw-behind-window true
        color "#00000064"
        // inactive-clor "#00000064"
    }

    tab-indicator {
        active-color "red"
        inactive-color "gray"
        urgent-color "blue"
        // active-color from="#..." to="#..." angle=45
    }

    geometry-corner-radius 12
    clip-to-geometry true
    tiled-state true
    baba-is-float true

    background-effect {
        xray true
        blur true
        noise 0.45
        saturation 3
    }

    popups {
        opacity 0.5
        geometry-corner-radius 15

        background-effect {
            // same as above
        }
    }

    min-width 100
    max-width 200
    min-height 300
    max-height 300
}

// Each window rule can have several match and exclude directives.
// In order for the rule to apply, a window needs to match any of the match directives,
// and none of the exclude directives.
/-window-rule {
    // Match all Telegram
    match app-id=r#"^org.\.telegram\.desktop$"#

    // ...except the media viewer window.
    // see title in the 'niri msg pick-window' result
    exclude title="^Media viewer"

    open-on-output "HDMI-A-1"
}

// Match and exclude directives have the same syntax.
// There can be multiple matchers in one directive, then the window
// shoult match all of them for directives to apply.
/-window-rule {
    // Match Firefox windows with Gmail in title.
    match app-id="firefox" title="Gmail"
}

/-window-rule {
    // Match Firefox, but only when it is active...
    match app-id="firefox" is-active=true

    // ...or match Telegram...
    match app-id=r#"^org\.telegram\.desktop$"#

    // ...but don't match the Telegram media viewer.
    // If you open a tab in Firefox titled "media viewer",
    // it will not be excluded directive.
    exclude app-id=r#"^org\.telegram\.desktop$"# title="Media viewer"
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true // force app to round corners

    background-effect {
        blur true
    }
}

window-rule {
    match app-id="helium"
    match app-id="Nautilus"
    match app-id="spotify"

    opacity 0.95
}

window-rule {
    match app-id="zen"
    match app-id="helium"

    open-maximized true
}

window-rule {
    match app-id="code"
    match app-id="VSCode"
    match app-id="vscode"

    opacity 0.97
    default-column-width { proportion 0.6; }
    default-fixed-height { proportion 0.8; }
}

window-rule {
    match app-id="Nautilus"
    default-fixed-height { proportion 0.6; }
}

window-rule {
    match app-id="ghostty"
    default-fixed-height { proportion 0.7; }
}
