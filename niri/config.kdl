// Import modules
include "modules/animations/material.kdl"
include "modules/keybinds/binds.kdl"
include "modules/environment.kdl"
include "modules/input.kdl"
include "modules/layer-rules.kdl"
include "modules/layout.kdl"
include "modules/outputs.kdl"
include "modules/window-rules.kdl"

/*
This flag will make niri ask the application
to omit their client-side decoratoins.
*/
prefer-no-csd

// Spawn process at startup.
spawn-at-startup "qs"

// You can also spawn shell-command at startup:
// spawn-shell-at-startup "swaybg -i path/to/image"

// Turn off hotkey popup at startup.
hotkey-overlay { skip-at-startup; }

// You can change the path where screenshots are saved.
// A ~ at the front will be expanded to the home directory.
// The path is formatted with strftime(3) to give you the screenshot date and time.
screenshot-path "~/Pictures/screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Blur configuration that affects all background blur.
blur { passes 5; offset 4.0; noise 0.05; saturation 1.8; }
